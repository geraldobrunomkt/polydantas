# Copie este arquivo para ".env.local" e preencha com os dados do seu projeto Supabase
# (Project Settings > API no painel do Supabase)

NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=coloque-a-service-role-key-aqui

# Frase secreta usada para assinar o cookie de login e proteger os PINs.
# Gere uma string aleatória grande (ex: rode `openssl rand -hex 32`) e não compartilhe.
SESSION_SECRET=troque-por-uma-string-aleatoria-bem-grande

# Chave da API do Gemini (Google AI Studio) - usada na Agenda para organizar
# texto corrido em compromissos. Gratis em https://aistudio.google.com
GEMINI_API_KEY=

# Buffer (buffer.com) - usado para agendar posts aprovados no Instagram/TikTok.
# Sem essas duas variaveis, o modulo de Aprovacao funciona normalmente
# (upload, revisao, aprovar/reprovar) so o agendamento automatico fica bloqueado.
BUFFER_ACCESS_TOKEN=
# Formato: "instagram:ID_DO_PERFIL,tiktok:ID_DO_PERFIL" (IDs dos perfis no Buffer)
BUFFER_PROFILE_IDS=

# Google Drive - usado para guardar VIDEOS enviados na Aprovacao de posts
# (o bucket do Supabase tem teto de 50MB/arquivo no plano gratis; o Drive nao
# tem esse limite pratico). Fotos/carrossel continuam indo pro Supabase.
# Sem essas 4 variaveis, video tambem cai no Supabase (sujeito ao limite de 50MB).
# Veja o README para o passo a passo de como gerar cada uma.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_DRIVE_FOLDER_ID=
