# Copie este arquivo para ".env.local" e preencha com os dados do seu projeto Supabase
# (Project Settings > API no painel do Supabase)

NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=coloque-a-service-role-key-aqui

# Frase secreta usada para assinar o cookie de login e proteger os PINs.
# Gere uma string aleatória grande (ex: rode `openssl rand -hex 32`) e não compartilhe.
SESSION_SECRET=troque-por-uma-string-aleatoria-bem-grande
